# =============================================================================
# VM1 —— BCP Pipeline 連線資訊
# =============================================================================
# ★ VM1 不跑容器 ★
#   這份檔案的正式位置是 /home/bcp_runner/.env（不是部署根目錄），
#   由 Dagster 透過 SSH 叫起來的 Python 腳本讀取。
#
# 使用方式（Phase 5-4）：
#   cp .env.example /home/bcp_runner/.env
#   vim /home/bcp_runner/.env
#   chown bcp_runner:bcp_runner /home/bcp_runner/.env
#   chmod 600 /home/bcp_runner/.env          ← ★裡面全是密碼，一定要 600★
#
# 這個檔案不進版控、也不在 rsync 範圍內
# （部署目標是 /home/bcp_runner/scripts/，不含家目錄）。
# =============================================================================

# --- 目的地資料庫（資料搬進去的那一台 MS SQL Server）-------------------------
# 用在：bcp_remote.py / clean_remote.py / check_source_db.py
DB_SERVER=10.0.0.100
DB_NAME=DAI
DB_USER=dai_bcp
DB_PASS=ChangeMe_TargetDB_2026

# --- 來源資料庫（對方直接開 DB 給我們讀的那一種）-----------------------------
# 用在：extract_source_db.py
SOURCE_DB_SERVER=10.0.0.200
SOURCE_DB_USER=dai_reader
SOURCE_DB_PASS=ChangeMe_SourceDB_2026
# 來源資料若為加密欄位，解密金鑰放這裡
# （extract_source_db.py 的 --decrypt-key-env 預設就是讀這個變數名）
SOURCE_DECRYPT_KEY=ChangeMe_SourceDecryptKey

# --- FTP（對方把檔案放在 FTP 的那一種）---------------------------------------
# 用在：fetch_ftp_remote.py / list_ftp_remote.py
# ★ 用帳密登入，不使用 .netrc ★
FTP_HOST=10.0.0.300
FTP_USER=dai_ftp
FTP_PASS=ChangeMe_Ftp_2026

# --- CSV 匯出加密金鑰 --------------------------------------------------------
# 用在：encrypt_remote.py / encryption.py
# 產生方式（Phase 5-5）：
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# ★ 換掉這把金鑰之後，先前用舊金鑰加密的 CSV 就解不開了 ★
#   產生後請另外備份到公司的密碼保管機制。
CSV_ENCRYPTION_KEY=ChangeMe_RunPythonToGenerate

# =============================================================================
# 以下為選用，視實際來源檔案而定
# =============================================================================
# 對方提供的是加密壓縮檔時，各檔案的解壓密碼。
# 目前 scripts/ 底下沒有任何程式讀這幾個變數，
# 若你們的流程有用到，取消註解並填值。
# ZIP_PWD_T_TXN_PS=
# ZIP_PWD_T_TXN_PS_FIRST=
# ZIP_PWD_T_CUST=
# ZIP_PWD_T_CUST_PS=
