# =============================================================================
# DAI · 部署包來源 repo（就是這個 repo）
# =============================================================================
# 這份檔案決定「什麼進版控」。
#
# ⚠️ 這**不是**兩個 GitLab repo 用的那份。
#    `dagster-workspace` / `bcp-scripts` 各自的 .gitignore 在
#    deploy_package_vm3/cicd_template/{dagster-workspace,bcp-scripts}/.gitignore，
#    由 install.sh 複製進去。那兩份的路徑前綴跟這裡不一樣（那邊沒有
#    deploy_package_vm4/workspace/ 這一層），改規則時三份都要看一下。
#
# 另有 deploy_exclude.txt 決定「rsync 不傳、也不刪」什麼 —— 兩者是不同的事，
# 新增一種執行期產物時請兩份都加。
# 對照說明：docs/GitLab維運手冊/進階調整/11_CD_rsync部署機制.md
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 機密（★最重要★ 進了版控就要走 git filter-repo 清歷史，不是刪掉就好）
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.env
!env.example
deploy_package_vm4/workspace/dagster_workspace/dagster_code/.env
deploy_package_vm4/workspace/dagster_workspace/dbt_project/profiles.yml

# 金鑰 / 憑證 / 密碼檔
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.crt
*.cer
!**/*.crt.example
# 例外：部署包裡的 CA 根／中繼憑證是公開資訊（不是機密），
#       四個包都要帶著它才能讓 host 信任內部服務，所以明確放行。
#       ★私鑰（*.key）不在放行之列，一律照上面的規則擋掉。★
!deploy_package_vm*/certs/GRCA3.crt
!deploy_package_vm*/certs/GCA3.crt
id_rsa*
id_ed25519*
*.ppk
.netrc
.pgpass
.my.cnf

# -----------------------------------------------------------------------------
# 2. 真實資料（絕對不可進版控：本系統處理的是個資與交易明細）
#     dbt seeds 若日後要用，請用 !deploy_package_vm4/workspace/dagster_workspace/dbt_project/seeds/ 明確放行
# -----------------------------------------------------------------------------
*.csv
*.tsv
*.xls
*.xlsx
*.zip
*.7z
*.gz
*.tar
*.bak
*.bcp
*.dat
*.parquet
data/
!docs/**/*.csv

# -----------------------------------------------------------------------------
# 3. Dagster 執行期產物
# -----------------------------------------------------------------------------
deploy_package_vm4/workspace/dagster_workspace/dagster_home/storage/
deploy_package_vm4/workspace/dagster_workspace/dagster_home/history/
deploy_package_vm4/workspace/dagster_workspace/dagster_home/logs/
deploy_package_vm4/workspace/dagster_workspace/dagster_home/schedules/
deploy_package_vm4/workspace/dagster_workspace/dagster_home/compute_logs/
deploy_package_vm4/workspace/dagster_workspace/dagster_home/.telemetry/
deploy_package_vm4/workspace/dagster_workspace/dagster_home/*.db
deploy_package_vm4/workspace/dagster_workspace/dagster_home/*.sqlite3
.dagster/
tmp*/

# -----------------------------------------------------------------------------
# 4. dbt 執行期產物（manifest 由 CD 在 VM4 上重新產生，不進版控）
# -----------------------------------------------------------------------------
deploy_package_vm4/workspace/dagster_workspace/dbt_project/target/
deploy_package_vm4/workspace/dagster_workspace/dbt_project/logs/
deploy_package_vm4/workspace/dagster_workspace/dbt_project/dbt_packages/
deploy_package_vm4/workspace/dagster_workspace/dbt_project/package-lock.yml
.user.yml

# -----------------------------------------------------------------------------
# 5. Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
.venv/
venv/
env/
ENV/
.python-version
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# -----------------------------------------------------------------------------
# 6. CI / 資安掃描產出（每次 pipeline 重新產生，不進版控）
# -----------------------------------------------------------------------------
bom.json
gitleaks-report.json
bandit-report.json
pip-audit-report.json
.sync_manifest*
*.sha256

# -----------------------------------------------------------------------------
# 7. 編輯器 / 作業系統
#     ._* 是 macOS AppleDouble；本地 hook 也會過濾掉它，這裡一併擋在版控外
# -----------------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
*~
.claude/

# -----------------------------------------------------------------------------
# 8. 本機暫存
# -----------------------------------------------------------------------------
*.log
!docs/**/*.log
scratch/
local/
NOTES_local.md
