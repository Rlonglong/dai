# =============================================================================
# VM5 —— Keycloak（含 LDAP 聯邦）+ Nginx + Superset
# =============================================================================
# 使用方式：
#   cd <VM5 部署根目錄>          # 例：/run/media/root/D/deploy
#   cp .env.example .env
#   vim .env
#   chmod 600 .env
#
# docker compose 會自動讀「跟 docker-compose.yml 同一層」的 .env。
# =============================================================================

# --- 其他 VM 的實際 IP（Phase 0-6）------------------------------------------
VM3_IP=10.0.0.3
VM4_IP=10.0.0.4

# --- 路徑（都要是「部署根目錄底下」的絕對路徑）-------------------------------
TLS_CERT_LOCAL_PATH=/run/media/root/D/deploy/certs
NGINX_CONFIG_DIR=/run/media/root/D/deploy/workspace/nginx/conf.d

# --- 連到 VM4 的 PostgreSQL（非預設 5432）------------------------------------
INFRA_DB_PORT=5433

# --- Keycloak ----------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=ChangeMe_KeycloakAdmin_2026
# 下面三個要跟 VM4 workspace/init-infra-db.sql 建立的 DB／帳號**完全一致**
# （那支 SQL 目前寫的是 kc_user / kc_pass，正式環境請兩邊一起換成強密碼）
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=kc_user
KEYCLOAK_DB_PASSWORD=kc_pass

# --- kc_access（Keycloak Access Controller）-----------------------------------
# ⚠️ VM4 的 init-infra-db.sql 有建 keycloak_access_db + keycloak_access_user，
#    但 compose 的 kc_access 服務沒有明確設定 DB 環境變數，是靠 env_file 整包帶進去的。
#    dai/kc_access:v2.0 這個映像實際讀哪幾個變數名稱要確認過再填，
#    填錯的話 kc_access 會起不來（或連到錯的 DB）。
# KC_ACCESS_DB_NAME=keycloak_access_db
# KC_ACCESS_DB_USER=keycloak_access_user
# KC_ACCESS_DB_PASSWORD=Keycloak_access_2026!

# --- Superset ----------------------------------------------------------------
# workspace/superset_config.py 讀這幾個（沒設就會用它自己的預設值，不要依賴）
SUPERSET_DB_NAME=superset_db
SUPERSET_DB_USER=superset_user
SUPERSET_DB_PASSWORD=Superset_2026!
# Flask session 簽章金鑰，務必換成隨機值：
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SUPERSET_SECRET_KEY=ChangeMe_SupersetSecretKey_2026
# 要跟 Phase 2-2 建立 keycloak「superset」client 時填的值一致
SUPERSET_OIDC_CLIENT_NAME=superset
SUPERSET_OIDC_CLIENT_SECRET=YourSupersetOidcSecret
