#!/usr/bin/env bash
# =============================================================================
# pre-commit hook —— 最早、最便宜的一道
# =============================================================================
# 安裝：ci/install_hooks.sh
#
# 這一關只掃「已經 staged 的內容」，目的是讓你在**金鑰進 commit 之前**就發現，
# 這樣頂多是 `git reset`，不用重寫歷史。
# 真正的守門員是 pre-push 與伺服器端的 pre-receive（見 ci/hooks/pre-push 的說明）。
#
# 環境變數：
#   DAI_SKIP_QUALITY=1   跳過品質檢查；資安檢查（gitleaks）永遠照跑
# =============================================================================

set -uo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
CI_DIR="${REPO_ROOT}/ci"

for venv in "${DAI_VENV:-}" "${REPO_ROOT}/.venv" "${HOME}/.venv"; do
    [[ -n "$venv" && -f "${venv}/bin/activate" ]] && { source "${venv}/bin/activate"; break; }
done

cd "$REPO_ROOT" || exit 1
fail=0

echo ""
echo "================================================================================"
echo " [1/2] 機密資訊防護 (gitleaks --staged)  ★ 不可跳過 ★"
echo "================================================================================"
"${CI_DIR}/check_secrets.sh" staged || fail=1
[[ $fail -ne 0 ]] && { echo ""; echo "❌ commit 已中止。"; exit 1; }

if [[ "${DAI_SKIP_QUALITY:-0}" == "1" ]]; then
    echo ""
    echo "⚠️  DAI_SKIP_QUALITY=1：略過品質檢查。"
    exit 0
fi

# 濾掉 AppleDouble（._foo.py）
mapfile -t STAGED < <(git diff --cached --name-only --diff-filter=ACMR \
    | grep -v '^\._' | grep -v '/\._' || true)

mapfile -t PY_FILES  < <(printf '%s\n' "${STAGED[@]:-}" | grep '\.py$'  | while read -r f; do [[ -f "$f" ]] && echo "$f"; done)
mapfile -t SQL_FILES < <(printf '%s\n' "${STAGED[@]:-}" | grep '\.sql$' | while read -r f; do [[ -f "$f" ]] && echo "$f"; done)

run_check() {
    local label="$1"; shift
    echo "--------------------------------------------------------"
    echo "  > 檢查: $label"
    echo "--------------------------------------------------------"
    local output status=0
    output="$("$@" 2>&1)" || status=$?
    if [[ $status -ne 0 ]]; then
        echo "❌ ${label} 失敗。"; echo ""
        printf '%s\n' "$output" | sed 's/^/| /'; echo ""
        fail=1; return 1
    fi
    [[ -n "$output" ]] && printf '%s\n' "$output"
    echo "✅ ${label} 通過。"; echo ""
}

echo ""
echo "================================================================================"
echo " [2/2] 靜態掃描與排版檢查 (flake8 / bandit / sqlfluff)"
echo "================================================================================"
if ((${#PY_FILES[@]} == 0)) && ((${#SQL_FILES[@]} == 0)); then
    echo "沒有需要檢查的 .py / .sql 檔案。"
else
    if ((${#PY_FILES[@]} > 0)); then
        command -v flake8 >/dev/null 2>&1 && run_check "Python 語法與品質 (flake8)" flake8 "${PY_FILES[@]}"
        command -v bandit >/dev/null 2>&1 && run_check "Python 資安掃描 (bandit)" bandit -q -c bandit.yaml -ll "${PY_FILES[@]}"
    fi
    if ((${#SQL_FILES[@]} > 0)); then
        command -v sqlfluff >/dev/null 2>&1 && run_check "SQL 語法規範 (sqlfluff)" sqlfluff lint --processes 1 "${SQL_FILES[@]}"
    fi
fi

[[ $fail -ne 0 ]] && { echo "❌ commit 已中止（可用 DAI_SKIP_QUALITY=1 只跳過品質檢查）。"; exit 1; }
echo "語法與資安檢查完畢！"
exit 0
