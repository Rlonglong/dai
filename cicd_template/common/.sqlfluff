[sqlfluff]
# dbt 模型最後跑在 SQL Server 上
dialect = tsql

# 用 jinja templater 而不是 dbt templater：
#   dbt templater 需要能連上資料庫才能編譯，CI runner 上沒有（也不該有）正式 DB 連線。
#   jinja templater 內建 ref/source/config/var/is_incremental 的 stub，夠用來檢查語法。
templater = jinja

exclude_rules =
    # LT05 行長：既有模型有大量長 CASE WHEN，另案處理
    LT05,
    # ST06 SELECT 欄位排序：與既有模型的欄位語意分組衝突
    ST06,
    # RF01 外部參照解析：jinja templater 看不到 ref() 真正的欄位
    RF01,
    # AM04 未知的欄位數（SELECT *）：中介層有意使用
    AM04

max_line_length = 160
processes = 1

[sqlfluff:templater:jinja]
# 讓 sqlfluff 讀得懂 macros/ 底下自訂的 get_config()、safe_divide() 等
load_macros_from_path = dagster_workspace/dbt_project/macros
apply_dbt_builtins = True

[sqlfluff:templater:jinja:context]
# 模型裡的 {{ var("target_date") }} 在 lint 時給一個假值
target_date = 2026-01-01

[sqlfluff:indentation]
indented_joins = False
indented_ctes = False
template_blocks_indent = False

[sqlfluff:rules:capitalisation.keywords]
capitalisation_policy = upper

[sqlfluff:rules:capitalisation.identifiers]
extended_capitalisation_policy = consistent

[sqlfluff:rules:capitalisation.functions]
extended_capitalisation_policy = upper

[sqlfluff:rules:aliasing.table]
aliasing = explicit

[sqlfluff:rules:ambiguous.column_references]
group_by_and_order_by_style = consistent
