# =============================================================================
# VM4 —— infra-db (PostgreSQL) + Dagster
# =============================================================================
# 使用方式：
#   cd /data/deploy
#   cp .env.example .env
#   vim .env
#   chmod 600 .env
#
# docker compose 會自動讀「跟 docker-compose.yml 同一層」的 .env。
# =============================================================================

# --- 其他 VM 的實際 IP（Phase 0-6）------------------------------------------
# 只有 VM5_IP 會被 compose 用到（dagster-login 要解析 auth.dai.post.gov.tw）。
# VM3 → VM4 的連線是 Phase 4 的 rsync over SSH，不經過 compose，所以這裡不需要 VM3_IP。
VM5_IP=10.0.0.5

# --- PostgreSQL（infra-db）---------------------------------------------------
# 這組是 PostgreSQL 的超級使用者，workspace/init-infra-db.sql 用它建其餘 DB
DB_USER=postgres
DB_PASSWORD=ChangeMe_Postgres_2026
DB_NAME=postgres
# 對外埠號（VM3 的 dtrack、VM5 的 keycloak/superset 都連這個）
INFRA_DB_PORT=5433

# --- Dagster 掛載路徑（都要是絕對路徑）---------------------------------------
# CD 會把 dagster-workspace repo rsync 到這個目錄，Phase 0-10 要 chown 給 UID 10001
DAGSTER_WORKSPACE=/data/deploy/workspace/dagster_workspace
# 落地檔工作目錄，容器內掛在 /data
DAGSTER_DATA_DIR=/data/deploy/workspace/dagster_data

# --- Dagster SSO（OAuth2 Proxy）----------------------------------------------
# 要跟 Phase 2-2 建立 keycloak「dagster」client 時填的 secret 完全一致
DAGSTER_OIDC_CLIENT_SECRET=YourDagsterOidcSecret

# OAuth2 Proxy 簽 session cookie 用的金鑰。
# ★長度必須剛好是 16 / 24 / 32 bytes★，不然容器會啟動失敗
#（訊息類似 cookie_secret must be 16, 24, or 32 bytes）。
# 用這行產生（32 bytes 的 base64）：
#   python3 -c 'import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())'
#
# 換掉這把金鑰會讓所有人的登入狀態失效，需要重新登入一次（只是這樣，沒有別的影響）。
DAGSTER_LOGIN_COOKIE_SECRET=ChangeMe_ProduceWithTheCommandAbove_

# host 端埠號，由 VM5 的 nginx 反向代理到 dagster.dai.post.gov.tw
DAGSTER_LOGIN_PORT=4180
