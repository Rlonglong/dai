# =============================================================================
# DAI 集中 log 的輪替設定（VM4）
# 部署路徑：/etc/logrotate.d/dai
# =============================================================================
# ⚠️ 輪替會改動檔案，一定要排在每日雜湊之後（cron 23:55 算雜湊，
#    logrotate 由 /etc/cron.daily 或 systemd timer 在隔天凌晨跑）。
#    順序反了會出現「manifest 記的檔案已經被壓縮改名」的假紅燈。
#
# 驗證語法（dry-run，不會真的輪替）：
#     logrotate -d /etc/logrotate.d/dai
# =============================================================================

/data/log/dai/*/*.log {
    daily
    rotate 90
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 root dai_admin
    su root dai_admin
    dateext
    dateformat -%Y%m%d
}

# 雜湊 manifest 保留久一點：它是稽核追溯的依據，本身很小
/var/log/dai-integrity/*.sha256
/var/log/dai-integrity/*.log {
    weekly
    rotate 104
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root dai_admin
    su root dai_admin
}
