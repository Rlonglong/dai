# =============================================================================
# VM3 —— GitLab + Container Registry + Dependency-Track + Nginx
# =============================================================================
# 使用方式：
#   cd <VM3 部署根目錄>          # 例：/run/media/root/D/deploy
#   cp .env.example .env
#   vim .env                     # 依下面註解填入實際值
#   chmod 600 .env
#
# docker compose 會自動讀「跟 docker-compose.yml 同一層」的 .env，
# 所以指令不需要帶 --env-file。
# =============================================================================

# --- 三台 VM 的實際 IP（Phase 0-6）------------------------------------------
VM3_IP=10.0.0.3
VM4_IP=10.0.0.4
VM5_IP=10.0.0.5

# --- 路徑（都要是「部署根目錄底下」的絕對路徑）-------------------------------
# 憑證目錄，掛給 nginx 與 gitlab-runner-ci
TLS_CERT_LOCAL_PATH=/run/media/root/D/deploy/certs
# nginx 的 conf.d，對應 workspace/nginx/conf.d
NGINX_VM3_CONFIG_DIR=/run/media/root/D/deploy/workspace/nginx/conf.d
# GitLab 的 config/logs/data 三個目錄的上層（Phase 3-1 會 mkdir）
GITLAB_HOME=/run/media/root/D/deploy/workspace/gitlab

# --- GitLab ------------------------------------------------------------------
GITLAB_ROOT_PASSWORD=ChangeMe_GitLabRoot_2026
# 要跟 Phase 2-2 建立 keycloak「gitlab」client 時填的 secret 完全一致
GITLAB_OIDC_CLIENT_SECRET=YourKeycloakGitlabSecret

# --- 連到 VM4 的 PostgreSQL（非預設 5432）------------------------------------
INFRA_DB_PORT=5433

# --- Dependency-Track --------------------------------------------------------
# 下面三個要跟 VM4 workspace/init-infra-db.sql 建立的 DB／帳號一致
DTRACK_DB_NAME=dtrack
DTRACK_DB_USER=dtrack_user
DTRACK_DB_PASSWORD=ChangeMe_Dtrack_2026
# Keycloak 上那個 public client 的 clientId（Phase 2-2 建的是 dependency-track）
DTRACK_CLIENT_ID=dependency-track
# host 端埠號，由 nginx 反向代理，不直接對外
DTRACK_API_PORT=8081
DTRACK_FRONT_PORT=8082

# --- Trivy（弱點掃描 server 模式）--------------------------------------------
TRIVY_SERVER_TOKEN=ChangeMe_TrivyToken_2026
